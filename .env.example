# Copia este archivo como .env.local y completa los valores.
# Obtén ambos en: Supabase Dashboard -> Project Settings -> API

# "Project URL", p. ej. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave "anon" / "publishable" (pública, protegida por RLS).
# NUNCA uses aquí la clave service_role: quedaría expuesta en el navegador.
VITE_SUPABASE_ANON_KEY=
