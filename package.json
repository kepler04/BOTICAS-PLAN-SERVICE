    "test:e2e": "node scripts/e2e-smoke.mjs",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:reset": "node scripts/demo.mjs reset",
    "demo:reseed": "node scripts/demo.mjs reseed",
    "screenshots": "node scripts/screenshots.mjs",
    "env:local": "node scripts/local-env.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:pwa": "node scripts/pwa-check.mjs",
    "test:csp": "node scripts/csp-check.mjs",
    "test:a11y": "node scripts/a11y-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
